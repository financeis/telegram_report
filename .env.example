# === Telegram API ===
# https://my.telegram.org 에서 발급
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 대상 채널
#  - public 채널: TELEGRAM_CHANNEL=username (예: sunstudy1004)
#  - private 채널: TELEGRAM_CHANNEL_ID=<int>  +  TELEGRAM_CHANNEL=<라벨>
#    (라벨은 DB의 chat_username 컬럼에 저장됨. 기존 데이터와 같은 값을
#     유지하면 옛 데이터와의 연속성이 유지됨.)
TELEGRAM_CHANNEL=sunstudy1004
# TELEGRAM_CHANNEL_ID=1378197756

# === Supabase ===
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=

# === 선택: 기본값 사용하려면 비워두면 됨 ===
# TELEGRAM_SESSION_NAME=samstudy
# STORAGE_BASE_DIR=./reports
# INITIAL_CUTOFF_DAYS=30
# MAX_CONCURRENT_DOWNLOADS=4   # 동시 다운로드 수. 백필 시 8 권장. FloodWait 자주 뜨면 줄이세요.
# LOG_LEVEL=INFO

# === tagger (python -m research_desk tag) ===
# 모델 이름이 provider를 정함: claude-* → ANTHROPIC_API_KEY, 그 외(gpt-*) → OPENAI_API_KEY.
# 쓰는 provider의 키만 있으면 됨. (구 이름 OPENAI_MODEL_* 도 계속 인식)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
LLM_MODEL_DEFAULT=claude-haiku-5-5
LLM_MODEL_ESCALATION=gpt-5.4
# Claude 사고 깊이: low | medium(기본) | high | xhigh | max
# ANTHROPIC_EFFORT=medium
MAX_CONCURRENT_LLM=2
TAGGER_BATCH_SIZE_DEFAULT=10
KRX_CSV_PATH=docs/stock_data/KRX_stocks_data.csv
# Direct Postgres connection string for Supabase. Required by every tag command
# (atomic claim / stale-lock reclaim / writes via asyncpg). Get it from
# Supabase project settings → Database → Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:<pw>@<host>:5432/postgres

# Concurrency / lock safety knobs (spec §9.5)
# LOCK_TTL_MINUTES * 60 must be > PER_ROW_DEADLINE_S so stale-lock reclaim
# never races a still-running worker.
LOCK_TTL_MINUTES=30
PER_ROW_DEADLINE_S=90

# === LangSmith (선택 — LangGraph 자동 trace) ===
# LangGraph 1.0+은 LANGSMITH_TRACING=true + LANGSMITH_API_KEY가 설정되어 있으면
# 모든 그래프 실행을 LangSmith로 자동 송출함. 코드 변경 불필요.
# https://smith.langchain.com 에서 API key 발급. 무료 tier 5,000 trace/월.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=langgraph-tagger     # 옵션 (없으면 'default' 프로젝트로 들어감)
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com    # 옵션 (기본값)

# === report analysis / compare (Research Desk web) ===
# Research Desk에서 리포트 분석·비교 버튼을 눌렀을 때만 호출. 미설정 시 default 사용.
# codex:<model> → 로컬 Codex CLI(`codex exec`, ChatGPT 로그인 계정 한도 사용, API 키 불필요).
# 리포트를 사용자가 골라 분석할 때만 호출됨. API로 돌리려면 gpt-6-luna.
LLM_MODEL_PHASE2=codex:gpt-6-luna
# CODEX_REASONING_EFFORT=high   # medium은 빠르지만 재무 지표가 ~40% 적게 나옴
PHASE2_PER_REPORT_TIMEOUT_S=180   # 재무 추출 프롬프트가 지표를 최대 48개까지 뽑아 gpt-6-luna 기준 최대 ~105초
PHASE2_MAX_INPUT_TOKENS=30000
PHASE2_SUMMARY_VERSION=llm-summary@1.0
